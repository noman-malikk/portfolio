---
import '../styles/global.css';
import ScrollProgress from '../components/ScrollProgress.svelte';

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const ogImage = Astro.site ? new URL(`${base}og-card.svg`, Astro.site).toString() : `${base}og-card.svg`;
const favicon = `${base}favicon.svg`;
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="theme-color" content="#f6f2ec" />
    <link rel="icon" href={favicon} />
    <script is:inline>
      const storedTheme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = storedTheme || (prefersDark ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);

      const storedMotion = localStorage.getItem('reduced-motion');
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const reduced = storedMotion ? storedMotion === 'true' : prefersReduced;
      document.documentElement.setAttribute('data-reduced-motion', reduced ? 'true' : 'false');
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <ScrollProgress client:load />
    <slot />
  </body>
</html>
