---
import BaseLayout from '../layouts/BaseLayout.astro';
import LayoutPlayground from '../components/LayoutPlayground.svelte';
import TrustDemo from '../components/TrustDemo.svelte';
import MaterialGallery from '../components/MaterialGallery.svelte';
import PerformanceLab from '../components/PerformanceLab.svelte';
import FlowResilience from '../components/FlowResilience.svelte';
import SkillClusters from '../components/SkillClusters.svelte';
import ComponentSandbox from '../components/ComponentSandbox.svelte';
import CommandPalette from '../components/CommandPalette.svelte';
import AccessibilityInspector from '../components/AccessibilityInspector.svelte';
import CopyEmailButton from '../components/CopyEmailButton.svelte';
import { profile } from '../data/profile';

type CommandAction = {
  label: string;
  type: 'section' | 'link' | 'toggle-theme' | 'toggle-motion';
  target?: string;
};

const description =
  'Portfolio of Noman Ali Malik, a front-end engineer in London building polished, responsive, high-performance interfaces.';
const base = import.meta.env.BASE_URL;
const portraitSrc = `${base}${profile.portrait.replace(/^\/+/, '')}`;

const commandActions: CommandAction[] = [
  { label: 'Go to Home', type: 'section', target: '#home' },
  { label: 'Go to Workbench', type: 'section', target: '#workbench' },
  { label: 'Go to Experience', type: 'section', target: '#experience' },
  { label: 'Go to Projects', type: 'section', target: '#projects' },
  { label: 'Go to Skills', type: 'section', target: '#skills' },
  { label: 'Go to Contact', type: 'section', target: '#contact' },
  { label: 'Open GitHub', type: 'link', target: `https://${profile.github}` },
  { label: 'Open LinkedIn', type: 'link', target: `https://${profile.linkedin}` },
  { label: 'Toggle Theme', type: 'toggle-theme' },
  { label: 'Toggle Reduced Motion', type: 'toggle-motion' }
];

const heroStats = [
  { value: '3+', label: 'Years shipping interfaces' },
  { value: '2', label: 'Product domains' },
  { value: 'UI', label: 'Systems + performance' }
];
---

<BaseLayout title={`${profile.name} | ${profile.title}`} description={description}>
  <header class="site-header">
    <div class="container nav">
      <a class="brand" href="#home" aria-label={`${profile.name} home`}>
        <span class="brand-mark">NM</span>
        <span>
          <span class="brand-name">{profile.name}</span>
          <span class="brand-role">{profile.title}</span>
        </span>
      </a>
      <nav class="nav-links" aria-label="Primary">
        <a href="#workbench">Workbench</a>
        <a href="#experience">Experience</a>
        <a href="#projects">Projects</a>
        <a href="#skills">Skills</a>
        <a href="#contact">Contact</a>
      </nav>
      <button class="icon-command command-trigger" data-command-open aria-label="Open command palette">
        <span>Command</span>
        <span class="kbd">Ctrl K</span>
      </button>
    </div>
  </header>

  <main id="main">
    <section id="home" class="hero-section">
      <div class="container hero">
        <div class="hero-copy">
          <p class="eyebrow">Available in {profile.location}</p>
          <h1 class="hero-title">I build clean product interfaces with sharp frontend craft.</h1>
          <p class="hero-subtitle">{profile.summary}</p>
          <div class="hero-cta">
            <a class="btn btn-primary" href="#projects">View work</a>
            <a class="btn btn-ghost" href={`mailto:${profile.email}`}>Email me</a>
            <a class="btn btn-ghost" href={`https://${profile.github}`} target="_blank" rel="noreferrer">GitHub</a>
          </div>
        </div>

        <aside class="portrait-panel" aria-label={`${profile.name} portrait and profile highlights`}>
          <div class="portrait-wrap">
            <img src={portraitSrc} alt={profile.name} class="portrait-image" loading="eager" />
          </div>
          <div class="portrait-caption">
            <span>{profile.title}</span>
            <strong>{profile.location}</strong>
          </div>
        </aside>
      </div>

      <div class="container hero-strip" aria-label="Highlights">
        {heroStats.map((stat) => (
          <div class="stat">
            <strong>{stat.value}</strong>
            <span>{stat.label}</span>
          </div>
        ))}
      </div>
    </section>

    <section id="workbench" class="section-band">
      <div class="container section-head">
        <p class="eyebrow">Interactive workbench</p>
        <h2 class="section-title">Frontend decisions you can poke at.</h2>
        <p class="section-lede">
          The site keeps the original interactive demos, but presents them as a sharper design and engineering
          workbench for layout, components, accessibility, and resilience.
        </p>
      </div>
      <div class="container workbench-grid">
        <div class="feature-card feature-card-large">
          <div class="card-kicker">01 / Layout</div>
          <h3>Responsive layout morph</h3>
          <p class="muted">
            Drag the control to see how layout choices respond across viewport sizes and density changes.
          </p>
          <LayoutPlayground client:load />
        </div>
        <div class="feature-card">
          <div class="card-kicker">02 / States</div>
          <h3>Component sandbox</h3>
          <p class="muted">Toggle UI states and inspect the component behavior.</p>
          <ComponentSandbox client:load />
        </div>
        <div class="feature-card">
          <div class="card-kicker">03 / Access</div>
          <h3>Accessibility pass</h3>
          <p class="muted">
            Use the floating inspector to reveal focus rings, heading hierarchy, and quick review cues.
          </p>
          <div class="panel">Open the inspector at the lower-right and toggle the review layers.</div>
        </div>
      </div>
    </section>

    <section id="experience">
      <div class="container section-head">
        <p class="eyebrow">Experience</p>
        <h2 class="section-title">Product work with a practical delivery rhythm.</h2>
        <p class="section-lede">
          Responsive SaaS and e-commerce interfaces, with a steady focus on performance, accessible states,
          and clear collaboration.
        </p>
      </div>
      <div class="container timeline">
        {profile.experience.map((role) => (
          <article class="timeline-item">
            <details open>
              <summary>
                <span>{role.role} - {role.company}</span>
                <span class="muted">{role.range}</span>
              </summary>
              <p class="muted">{role.location}</p>
              <div class="grid-2">
                <div>
                  <h4>Impact</h4>
                  <ul>
                    {role.impact.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
                <div class="panel">
                  <h4>Focus areas</h4>
                  <ul>
                    {role.focus.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </details>
          </article>
        ))}
      </div>
    </section>

    <section id="projects" class="section-band">
      <div class="container section-head">
        <p class="eyebrow">Selected work</p>
        <h2 class="section-title">Trust, speed, and interface systems.</h2>
        <p class="section-lede">
          A featured blockchain project plus smaller UI case studies that reflect production constraints.
        </p>
      </div>
      <div class="container project-layout">
        <article class="feature-card project-hero">
          <div class="card-kicker">Featured project</div>
          <h3>{profile.project.name}</h3>
          <p class="muted">{profile.project.description}</p>
          <div class="tag-row">
            {profile.project.stack.map((item) => (
              <span class="tag">{item}</span>
            ))}
          </div>
          <TrustDemo client:load />
          <div class="cta-row">
            <a class="btn btn-ghost" href={profile.project.linkUrl} target="_blank" rel="noreferrer">
              {profile.project.linkLabel}
            </a>
          </div>
        </article>

        <div class="case-stack">
          <article class="feature-card">
            <h3>{profile.microCaseStudies[0].title}</h3>
            <p class="muted">{profile.microCaseStudies[0].summary}</p>
            <MaterialGallery client:load />
            <p class="muted case-note">{profile.microCaseStudies[0].note}</p>
          </article>
          <article class="feature-card">
            <h3>{profile.microCaseStudies[1].title}</h3>
            <p class="muted">{profile.microCaseStudies[1].summary}</p>
            <PerformanceLab client:load />
            <p class="muted case-note">{profile.microCaseStudies[1].note}</p>
          </article>
          <article class="feature-card">
            <h3>{profile.microCaseStudies[2].title}</h3>
            <p class="muted">{profile.microCaseStudies[2].summary}</p>
            <FlowResilience client:load />
            <p class="muted case-note">{profile.microCaseStudies[2].note}</p>
          </article>
        </div>
      </div>
    </section>

    <section id="skills">
      <div class="container section-head">
        <p class="eyebrow">Capability map</p>
        <h2 class="section-title">Skills grouped by how products actually get built.</h2>
        <p class="section-lede">
          Frontend engineering, UI systems, backend integration, cloud delivery, testing, and practical team habits.
        </p>
      </div>
      <div class="container">
        <SkillClusters client:load clusters={profile.skills} />
      </div>
    </section>

    <section id="education" class="education-strip">
      <div class="container split">
        <div>
          <p class="eyebrow">Education</p>
          <h2 class="section-title">{profile.education.degree}</h2>
        </div>
        <div class="panel">
          <strong>{profile.education.school}</strong>
          <p class="muted">{profile.education.location}</p>
        </div>
      </div>
    </section>

    <section id="contact" class="contact-section">
      <div class="container contact-card">
        <div>
          <p class="eyebrow">Contact</p>
          <h2 class="section-title">Let’s build an interface people can trust.</h2>
          <p class="section-lede">
            I’m open to frontend roles and projects where polished UI, maintainable code, and performance matter.
          </p>
          <div class="contact-lines">
            <span>{profile.email}</span>
            <span>{profile.phone}</span>
            <span>{profile.linkedin}</span>
          </div>
        </div>
        <div class="contact-actions">
          <CopyEmailButton client:load email={profile.email} />
          <a class="btn btn-primary" href={`mailto:${profile.email}`}>Send email</a>
          <a class="btn btn-ghost" href={`https://${profile.linkedin}`} target="_blank" rel="noreferrer">
            LinkedIn
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer-grid">
      <span>(c) {new Date().getFullYear()} {profile.name}</span>
      <span class="muted">Studio Console theme</span>
      <span class="muted">Built with Astro</span>
    </div>
  </footer>

  <CommandPalette client:load actions={commandActions} />
  <AccessibilityInspector client:load />
</BaseLayout>
